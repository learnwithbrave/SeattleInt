# Public client configuration for the later Phase 2 frontend integration.
# The current frontend does not consume these values yet.
# A publishable key is browser-visible by design; security is enforced by SQL grants and RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Never add a Supabase secret key, SMTP credential, anti-spam secret, or provider token here.
# Server-side secrets belong only in the backend/deployment secret store.
